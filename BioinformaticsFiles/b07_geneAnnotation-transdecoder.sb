#!/bin/bash -login

#SBATCH --time=36:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --mem=64G
#SBATCH --account colej
#SBATCH --job-name b07transdecoder
#SBATCH --array=1-34
#SBATCH -o slurm-%A_%a_transdecoder.out

cd ${SLURM_SUBMIT_DIR}
cores="$SLURM_CPUS_PER_TASK"
RAM="$SLURM_MEM_PER_NODE"

source ../config.yaml

echo -e "\n Running script: b07_predictproteinregions_transdecoder.sb \n"

echo -e "\n========== Sub-directories ==========\n"
echo -e "mkdir -p $project_dir/outputs/b07_predictproteinregions_transdecoder"; mkdir -p $project_dir/outputs/b07_predictproteinregions_transdecoder

echo -e "\n========== Generate array list ==========\n"
sampleID=$(awk -v ArrayTaskID=$SLURM_ARRAY_TASK_ID '$1==ArrayTaskID {print $2}' $project_dir/array/sampleID.array)

echo -e "\n========== gene prediction of $Contigs with TransDEcoder ==========\n"
conda activate transdecoder
echo -e "version of Transdecoder: `transdecoder --version`" 

#make subdirectory, set that dirr
mkdir -p $project_dir/outputs/b07_predictproteinregions_transdecoder/${sampleID}
cd $project_dir/outputs/b02_assembly_spades/${sampleID}


# run
TransDecoder.LongOrfs -t transcripts.fasta

TransDecoder.Predict  -t transcripts.fasta


mv $project_dir/outputs/b02_assembly_spades/${sampleID}/transcripts.fasta.transdecoder_dir $project_dir/outputs/outputs/b07_predictproteinregions_transdecoder/${sampleID}/

#rfam - enable searching for ncRNAs with Infernal+Rfam (SLOW!), default 0
#force - force overwriting existing output folder
#compliant - Force Genbank/ENA/DDJB compliance: --genes --mincontiglen 200 --centre 
#addgenes- dd 'gene' features for each 'CDS' feature (default OFF)
#centre- Sequencing centre ID. (default '')
#locustag- Locus tag prefix (default 'PROKKA')


conda deactivate


# find /mnt/research/EvansLab/Benucci/metaGAAP/outputs/b02_assembly_spades/ -type f  -name "scaffolds_hq.fasta"
echo -e "\n========== Sbatch log ==========\n"
echo -e "\n Current directory: `pwd` \n"
echo -e "\n `sacct -u broder49 -j $SLURM_JOB_ID --format=JobID,JobName,Start,End,Elapsed,NCPUS,ReqMem` \n"
scontrol show job $SLURM_JOB_ID


