#!/bin/bash -login

#SBATCH --time=00:15:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --job-name a07nonpareil
#SBATCH --output=slurm-%A_a07_plotRedundancyCurves-nonpareil.out 


cd ${SLURM_SUBMIT_DIR}
cores=$SLURM_CPUS_PER_TASK
RAM_NODE=$SLURM_MEM_PER_NODE

echo -e "metaGAAP v. 1.0 - metaGenome Assembly and Annotation Pipeline
MIT LICENSE - Copyright © 2022 Benucci Jones Broderick
email: benucci[at]msu[dot]edu\n"

source ../config.yaml

echo -e "\n Running script: a07_plotRedundancyCurves-nonpareil.sb \n"

echo -e "\n========== Sub-directories ==========\n"

echo -e "\n========== Generating Nonpareil redundancy curves ==========\n"
(echo -e 'Samples'; ls $project_dir/outputs/a06_coverageEstimation_nonpareil/*.npo; ) > \
	$project_dir/outputs/a06_coverageEstimation_nonpareil/nonpareilFiles.list

conda activate R
cd $project_dir/outputs/a06_coverageEstimation_nonpareil/
Rscript $project_dir/mycode/plotRedundancyCurves.R
conda deactivate

