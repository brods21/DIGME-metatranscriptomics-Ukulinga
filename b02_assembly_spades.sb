#!/bin/bash -login

#SBATCH --time=24:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=320G
#SBATCH --account shade-cole-bonito
#SBATCH --array=1-34
#SBATCH --job-name b02spades
#SBATCH --output=slurm-%A_%a_b02_assembly-spades.out 

cd ${SLURM_SUBMIT_DIR}
cores="$SLURM_CPUS_PER_TASK"
RAM="$SLURM_MEM_PER_NODE"

echo -e "\n========== Project paths ==========\n"

echo -e "metaGAAP v. 1.0 - metaGenome Assembly and Annotation Pipeline
MIT LICENSE - Copyright © 2022 Benucci Jones Broderick
email: benucci[at]msu[dot]edu\n"

source ../config.yaml

echo -e "\n I am running: b02_assembly-spades.sb \n"

echo -e "\n========== Sub-directories ==========\n"
# Run it before on array using 24 cores and 256 GB ram, 1 sample failed.

echo "mkdir $project_dir/outputs/b02_assembly_spades/"; mkdir $project_dir/outputs/b02_assembly_spades/

echo -e "\n========== Creating the array list ==========\n"

sampleID=$(awk -v ArrayTaskID=$SLURM_ARRAY_TASK_ID '$1==ArrayTaskID {print $2}' $project_dir/array/sampleID.array)

echo -e "\n========== Assembly with Spades for file: $sampleID ==========\n"
conda activate spades
echo -e "Spades version: `spades.py --version`" 

spades.py \
	-t $cores \
	-m $RAM \
	-k 21,33,55,77,99,127 \
	--rna \
	--only-assembler \
	--pe1-1 $project_dir/outputs/a07_removerrna_ribodetector/${sampleID}_norRNA_R1.fastq.gz \
	--pe1-2 $project_dir/outputs/a07_removerrna_ribodetector/${sampleID}_norRNA_R2.fastq.gz \
	-o $project_dir/outputs/b02_assembly_spades/${sampleID}/

conda deactivate

echo -e "\n========== Sbatch log ==========\n"
echo -e "\n Current directory: `pwd` \n"
echo -e "\n `sacct -u broder49 -j $SLURM_JOB_ID --format=JobID,JobName,Start,End,Elapsed,NCPUS,ReqMem` \n"
scontrol show job $SLURM_JOB_ID 

