#!/bin/bash -login

#SBATCH --time=03:59:00 
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G  
#SBATCH --array=1-34
#SBATCH --job-name a02bowtie2
#SBATCH --output=slurm-%A_%a_a02_removingPhix-bowtie2.out 

cd ${SLURM_SUBMIT_DIR}
cores=$SLURM_CPUS_PER_TASK
RAM=$SLURM_MEM_PER_NODE

echo -e "metaGAAP v. 1.0 - metaGenome Assembly and Annotation Pipeline
MIT LICENSE - Copyright © 2022 Benucci Jones Broderick
email: benucci[at]msu[dot]edu\n"

source ../config.yaml

echo -e "\n Running script: a02_removingPhix-bowtie2.sb \n"

echo -e "\n========== Sub-directories ==========\n"
echo "mkdir $project_dir/outputs/a02_removePhix_bowtie2/"; mkdir $project_dir/outputs/a02_removePhix_bowtie2/

echo -e "\n========== Generatinng the array list ==========\n"

sampleID=$(awk -v ArrayTaskID=$SLURM_ARRAY_TASK_ID '$1==ArrayTaskID {print $2}' $project_dir/array/sampleID.array)

echo -e "\n========== filtering PhiX in: $sampleID ==========\n"
conda activate bowtie2
echo -e "Bowtie2 version: `bowtie2 --version`"

bowtie2 \
	-x $phix_db \
	-1 $rawdata/${sampleID}_R1_001.fastq.gz \
	-2 $rawdata/${sampleID}_R2_001.fastq.gz\
	-p $cores \
	--un-conc-gz $project_dir/outputs/a02_removePhix_bowtie2/${sampleID}.fastq.gz \
	-S $project_dir/outputs/a02_removePhix_bowtie2/${sampleID}_contaminated_align.sam \
	--local

conda deactivate

mv $project_dir/outputs/a02_removePhix_bowtie2/${sampleID}.fastq.1.gz $project_dir/outputs/a02_removePhix_bowtie2/${sampleID}_R1.fastq.gz
mv $project_dir/outputs/a02_removePhix_bowtie2/${sampleID}.fastq.2.gz $project_dir/outputs/a02_removePhix_bowtie2/${sampleID}_R2.fastq.gz

rm $project_dir/outputs/a02_removePhix_bowtie2/${sampleID}_contaminated_align.sam

# --local "trim" or "clip" some read characters from one or both ends of the alignment.
# --un-conc Write paired-end reads that fail to align concordantly to file(s) at <path>. 
# --al-conc Write paired-end reads that align concordantly at least once to file(s) at <path>. 
echo -e "\n========== Sbatch log ==========\n"
echo -e "\n Current directory: `pwd` \n"
echo -e "\n `sacct -u broder49 -j $SLURM_JOB_ID --format=JobID,JobName,Start,End,Elapsed,NCPUS,ReqMem` \n"
scontrol show job $SLURM_JOB_ID

