#!/bin/bash -login

#SBATCH --time=03:59:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --mem=48G
#SBATCH --array=1-34
#SBATCH --job-name a06Nonpar
#SBATCH --output=slurm-%A_%a_a07_coverageEstimation_nonpareil.out 

cd ${SLURM_SUBMIT_DIR}
cores="$SLURM_CPUS_PER_TASK"
RAM_NODE="$SLURM_MEM_PER_NODE"

echo -e "\n========== Project paths ==========\n"
source ../config.yaml

echo -e "metaGAAP v. 1.0 - metaGenome Assembly and Annotation Pipeline
MIT LICENSE - Copyright © 2022 Benucci Jones Broderick
email: benucci[at]msu[dot]edu\n"

echo -e "\n I am running: a06_coverageEstimation_nonpareil.sb \n"

echo -e "\n========== Sub-directories ==========\n"
echo "mkdir -p $project_dir/outputs/a06_coverageEstimation_nonpareil/"; mkdir -p $project_dir/outputs/a06_coverageEstimation_nonpareil/

echo -e "\n========== Generate array list ==========\n"

sampleID=$(awk -v ArrayTaskID=$SLURM_ARRAY_TASK_ID '$1==ArrayTaskID {print $2}' $project_dir/array/sampleID.array)

echo -e "\n========== Coverage Estimation using Nonpareil ==========\n"
conda activate nonpareil
echo -e "Spades version: `nonpareil--version`" 

unpigz -p $cores $project_dir/outputs/a03_trimmingadapters_fastp/${sampleID}_trimmed_R1.fastq.gz

nonpareil \
	-R $RAM_NODE \
	-t $cores \
	-s $project_dir/outputs/a03_trimmingadapters_fastp/${sampleID}_trimmed_R1.fastq \
	-T kmer \
	-f fastq \
	-b $project_dir/outputs/a06_coverageEstimation_nonpareil/${sampleID}

pigz -p $cores $project_dir/outputs/a03_trimmingadapters_fastp/${sampleID}_trimmed_R1.fastq

echo -e "\n========== Sbatch log ==========\n"
echo -e "\n Current directory: `pwd` \n"
echo -e "\n `sacct -u broder49 -j $SLURM_JOB_ID --format=JobID,JobName,Start,End,Elapsed,NCPUS` \n"
echo -e "\n SLURM ARRAY ID: `$SLURM_ARRAY_TASK_ID`\n"
scontrol show job $SLURM_JOB_ID

