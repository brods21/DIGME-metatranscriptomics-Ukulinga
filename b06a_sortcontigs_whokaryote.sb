#!/bin/bash -login

#SBATCH --time=24:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --job-name b06a_sortcontigs
#SBATCH --array=1-34
#SBATCH -o slurm-%A_%a_whokaryote.out

cd ${SLURM_SUBMIT_DIR}
cores="$SLURM_CPUS_PER_TASK"
RAM="$SLURM_MEM_PER_NODE"

echo -e "\n========== Project paths ==========\n"
source ../config.yaml

echo -e "\n I am running: b06a_sortcontigs_whokaryote.sb \n"

echo -e "\n========== Sub-directories ==========\n"
echo "mkdir -p $project_dir/outputs/b06a_sortcontigs_whokaryote/"; mkdir -p $project_dir/outputs/b06a_sortcontigs_whokaryote/

echo -e "\n========== Genrate array list ==========\n"

sampleID=$(awk -v ArrayTaskID=$SLURM_ARRAY_TASK_ID '$1==ArrayTaskID {print $2}' $project_dir/array/sampleID.array)

mkdir $project_dir/outputs/b06a_sortcontigs_whokaryote/${sampleID}

echo -e "\n========== whokaryote: $sampleID ==========\n"
conda activate whokaryote

whokaryote.py \
	--contigs $project_dir/outputs/b02_assembly_spades/${sampleID}/scaffolds_hq.fasta \
	--outdir $project_dir/outputs/b06a_sortcontigs_whokaryote/${sampleID} \
	--minsize 1000


conda deactivate

echo -e "\n========== Sbatch log ==========\n"
echo -e "\n Current directory: `pwd` \n"
echo -e "\n `sacct -u broder49 -j $SLURM_JOB_ID --format=JobID,JobName,Start,End,Elapsed,NCPUS,ReqMem` \n"
scontrol show job $SLURM_JOB_ID

